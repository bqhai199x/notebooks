# Cloudflare R2 (runtime storage)
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=notes-production
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Maximum file size. The default is 1 GiB when this is omitted.
MAX_UPLOAD_BYTES=1073741824
# Multipart part size: 5 MiB through 512 MiB. Use 8 MiB on Vercel.
R2_UPLOAD_PART_BYTES=8388608

# Set to true only during a migration or maintenance window. Reads still work.
# NOTES_READ_ONLY=true

# A long secret that unlocks the default notebook space.
NOTES_ACCESS_KEY=replace-with-a-long-random-secret

# Optional independent spaces.
# NOTES_ACCESS_KEYS=work:secretKey1,personal:secretKey2

# Google Drive credentials are only needed while running `npm run migrate:r2`.
# GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REFRESH_TOKEN=your-refresh-token
# Or use a Workspace Shared Drive service account:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@project-id.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
