# S3 storage
AWS_REGION=ap-southeast-1
S3_BUCKET=your-private-bucket
S3_NOTES_KEY=notes/sessions.json
S3_UPLOAD_PREFIX=notes/uploads
# Maximum size of one attachment in bytes (default: 1 GiB).
MAX_UPLOAD_BYTES=1073741824

# Mã mở sổ tay. Đặt một chuỗi dài, ngẫu nhiên; không dùng mật khẩu AWS.
NOTES_ACCESS_KEY=replace-with-a-long-random-secret

# Chỉ dùng cho local development. Trên Vercel, thêm các biến này trong Project Settings.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
