# ========================================================
# CẤU HÌNH GOOGLE DRIVE API CHO ỨNG DỤNG NOTES
# ========================================================

# ID của thư mục trên Google Drive dùng để lưu dữ liệu (sessions.json & uploads)
# Lấy từ URL thư mục: https://drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# --- PHƯƠNG THỨC 1: OAuth 2.0 (Khuyên dùng cho Gmail cá nhân) ---
# Chạy lệnh: npm run auth:gdrive để tự động lấy GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# --- PHƯƠNG THỨC 2: Service Account (Chỉ dùng nếu có Google Workspace Shared Drive) ---
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@project-id.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Giới hạn kích thước 1 file tải lên tính theo bytes (mặc định: 1 GiB = 1073741824).
MAX_UPLOAD_BYTES=1073741824

# Mã khóa mở sổ tay (đặt chuỗi bảo mật ngẫu nhiên của bạn).
NOTES_ACCESS_KEY=replace-with-a-long-random-secret

# Hoặc hỗ trợ nhiều người dùng/phân vùng không gian riêng:
# NOTES_ACCESS_KEYS=work:secretKey1,personal:secretKey2
